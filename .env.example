# Database (Docker Postgres on port 5433)
DATABASE_URL=postgresql://claude_chat:claude_chat@localhost:5433/claude_chat

# Frontend origin for CORS
CORS_ORIGINS=http://localhost:5173

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# API base URL override (optional, leave empty for default: https://api.anthropic.com)
ANTHROPIC_BASE_URL=

# Model (optional, leave empty for CLI default: claude-sonnet-4-5-20250514)
ANTHROPIC_MODEL=

# Smaller/faster model for background tasks (title generation, follow-up suggestions)
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001
